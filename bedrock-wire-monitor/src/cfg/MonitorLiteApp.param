bedrock.wire.monitor.enabled=true
monitor.default.interval=5s
monitor.default.retry.count=1
monitor.default.retry.delay=2s
monitor.default.validation.validators=httpStatus
monitor.default.header.Accept=application/xml
monitor.default.header.X-Client-Id=bedrock-monitor

monitor.tls.ckp-tls.clientCert=bedrock-wire-monitor/src/cfg/certifications/monitor_tst.pfx
monitor.tls.ckp-tls.clientCertPassword=Hobrt5489
monitor.tls.ckp-tls.clientCertType=PKCS12

monitor.service.px1ps.url=https://wstst.ckp.cz:4444
monitor.service.px1ps.header.Content-Type=application/xml
monitor.service.px1ps.transport.responseTimeout=10s
monitor.service.px1ps.transport.connectionTimeout=3s
monitor.service.px1ps.transport.tlsProfile=ckp-tls

monitor.check.ckp-px1ps.service=px1ps
monitor.check.ckp-px1ps.method=POST
monitor.check.ckp-px1ps.path=/nor_tst/PX1PS/2024/05
monitor.check.ckp-px1ps.templateFile=bedrock-wire-monitor/src/cfg/body/requestBody.xml
monitor.check.ckp-px1ps.param.clientId=monitor-prod
monitor.check.ckp-px1ps.validation.validators=httpStatus,contains
monitor.check.ckp-px1ps.validation.httpStatus=200
monitor.check.ckp-px1ps.validation.contains=<status>OK</status

bedrock.wire.monitor.config-file=bedrock-wire-monitor/src/cfg/MonitorLiteApp.param

